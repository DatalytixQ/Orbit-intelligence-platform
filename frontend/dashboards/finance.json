{
  "id": "finance",
  "name": "DQ Orbit — Workspace de Finanzas",
  "description": "Monitoreo ejecutivo de cartera, aging, exposición vencida e inteligencia financiera",
  "domain": "Finanzas",
  "version": "2.0.0",
  "layout": {
    "columns": 4,
    "rowHeight": 120,
    "gap": 16
  },
  "widgets": [
    {
      "id": "finance-kpi-dso",
      "type": "kpi",
      "title": "DSO Global (Días)",
      "metric": "dso-kpi",
      "size": "sm",
      "kpiConfig": {
        "format": "number",
        "severity": "neutral"
      },
      "gridPosition": { "x": 0, "y": 0, "w": 1, "h": 1 }
    },
    {
      "id": "finance-kpi-overdue",
      "type": "kpi",
      "title": "Mora Total",
      "metric": "overdue-kpi",
      "size": "sm",
      "kpiConfig": {
        "format": "currency",
        "currency": "ARS",
        "severity": "warning"
      },
      "gridPosition": { "x": 1, "y": 0, "w": 1, "h": 1 }
    },
    {
      "id": "finance-kpi-critical",
      "type": "kpi",
      "title": "Mora Crítica (>90)",
      "metric": "critical-kpi",
      "size": "sm",
      "kpiConfig": {
        "format": "currency",
        "currency": "ARS",
        "severity": "critical"
      },
      "gridPosition": { "x": 2, "y": 0, "w": 1, "h": 1 }
    },
    {
      "id": "finance-kpi-customers",
      "type": "kpi",
      "title": "Clientes Críticos",
      "metric": "customers-kpi",
      "size": "sm",
      "kpiConfig": {
        "format": "number",
        "severity": "critical"
      },
      "gridPosition": { "x": 3, "y": 0, "w": 1, "h": 1 }
    },
    {
      "id": "finance-aging-chart",
      "type": "bar-chart",
      "title": "Aging de Cartera",
      "metric": "/api/kpi/finance/ar-aging-summary",
      "size": "md",
      "chartConfig": {
        "xField": "aging_bucket",
        "yField": "open_balance",
        "colorField": "aging_bucket",
        "orientation": "horizontal",
        "showLegend": true
      },
      "gridPosition": { "x": 0, "y": 1, "w": 3, "h": 3 }
    },
    {
      "id": "finance-risk-table",
      "type": "table",
      "title": "Top Clientes en Riesgo",
      "metric": "/api/kpi/finance/top-risk-customers",
      "size": "md",
      "tableConfig": {
        "columns": [
          { "key": "customer_name", "label": "Cliente", "format": "text", "sortable": true },
          { "key": "risk_segment", "label": "Segmento", "format": "text", "sortable": true },
          { "key": "overdue_balance", "label": "Mora", "format": "currency", "sortable": true }
        ],
        "maxRows": 5
      },
      "gridPosition": { "x": 0, "y": 4, "w": 3, "h": 3 }
    },
    {
      "id": "finance-insights",
      "type": "insight",
      "title": "Puntos de Atención Prioritaria",
      "subtitle": "¿Qué debo resolver hoy?",
      "metric": "finance-insights-data",
      "size": "sm",
      "drillThrough": {
        "type": "ai",
        "target": "Analizar la cartera vencida en finanzas"
      },
      "gridPosition": { "x": 3, "y": 1, "w": 1, "h": 6 }
    }
  ]
}
