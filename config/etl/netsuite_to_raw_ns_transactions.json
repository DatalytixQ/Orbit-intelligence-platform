{
  "integration": "NetSuite_SuiteQL",
  "target_table": "raw_ns_transactions",
  "primary_keys": ["transaction_id"],
  "description": "Mapeo maestro de cabeceras de transacciones",
  "extraction": {
    "type": "REST_SUITEQL",
    "base_query": "SELECT id, tranid, trandate, postingperiod, type, status, entity, currency, exchangerate, lastmodifieddate, taxtotal, employee, createdfrom, probability, expectedclosedate, entitystatus, saleschannel FROM transaction",
    "filters": [
      { "field": "type", "operator": "IN", "value": "('CustInvc', 'CashSale', 'SalesOrd', 'Estimate', 'CreditMemo', 'ReturnAuth', 'CashRfnd', 'CustCred')" },
      { "field": "lastmodifieddate", "operator": ">=", "value": "TO_DATE('{{LAST_SYNC_DATE}}', 'YYYY-MM-DD HH24:MI:SS')" }
    ]
  },
  "mapping": {
    "transaction_id": { "source_field": "id", "type": "string" },
    "tranid": { "source_field": "tranid", "type": "string" },
    "trandate": { "source_field": "trandate", "type": "date" },
    "posting_period_id": { "source_field": "postingperiod", "type": "string" },
    "type": { "source_field": "type", "type": "string" },
    "status": { "source_field": "status", "type": "string" },
    "entity_id": { "source_field": "entity", "type": "string" },
    "currency_id": { "source_field": "currency", "type": "string" },
    "exchange_rate": { "source_field": "exchangerate", "type": "number" },
    "last_modified_ts": { "source_field": "lastmodifieddate", "type": "date" },
    "tax_total": { "source_field": "taxtotal", "type": "number" },
    "salesrep_id": { "source_field": "employee", "type": "string" },
    "created_from_id": { "source_field": "createdfrom", "type": "string" },
    "probability": { "source_field": "probability", "type": "number" },
    "expected_close_date": { "source_field": "expectedclosedate", "type": "date" },
    "entity_status": { "source_field": "entitystatus", "type": "string" },
    "sales_channel": { "source_field": "saleschannel", "type": "string" }
  },
  "defaults": {
    "source_system": "netsuite",
    "client_id": "vonderk",
    "snapshot_ts": "{{CURRENT_TIMESTAMP}}"
  },
  "validation_rules": [
    { "field": "transaction_id", "rule": "is_not_null" }
  ]
}
